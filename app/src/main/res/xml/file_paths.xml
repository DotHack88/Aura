<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Store images in the external cache directory -->
    <external-cache-path name="shared_images" path="images/" />
    <!-- Also support internal cache as fallback -->
    <cache-path name="shared_images_internal" path="images/" />
    <!-- Shared videos from FFmpeg generation -->
    <cache-path name="shared_videos" path="videos/" />
</paths>
